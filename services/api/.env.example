# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://guftagu:guftagu@localhost:5432/guftagu?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ALLOW_DEV_AUTH=true
DEV_OTP_CODE=000000

# OTP Provider: dev | twilio | firebase
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=guftagu-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# FCM
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Rate limiting
OTP_RESEND_COOLDOWN_SEC=60
OTP_EXPIRY_SEC=300
OTP_MAX_ATTEMPTS=5

# Frontend
MOBILE_BUNDLE_ID=com.ruhikreguftagu.saad
