generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  FILE
  SYSTEM
  PLAN
  TRIVIA
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum RsvpStatus {
  IN
  MAYBE
  CANT
}

enum TriviaState {
  LOBBY
  QUESTION
  REVEAL
  FINISHED
  ABANDONED
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  ENDED
  MISSED
  BUSY
  FAILED
}

enum CallType {
  AUDIO
  VIDEO
}

model User {
  id          String   @id @default(cuid())
  phone       String?  @unique
  phoneHash   String?  @unique // hashed for privacy checks
  username    String   @unique
  displayName String
  bio         String?  @db.Text
  avatarUrl   String?
  lastSeenAt  DateTime?
  readReceiptsEnabled Boolean @default(true)
  lastSeenEnabled Boolean @default(true)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]
  sessions    Session[]
  memberships Membership[]
  messages    Message[] @relation("MessageSender")
  reactions   Reaction[]
  rsvps       PlanRsvp[]
  votes       PlanVote[]
  triviaAnswers TriviaAnswer[]
  blocksInitiated Block[] @relation("Blocker")
  blocksReceived  Block[] @relation("Blocked")
  reports     Report[]
  pushTokens  PushToken[]
  plansCreated Plan[] @relation("PlanOrganizer")

  @@index([username])
  @@index([phoneHash])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String // android, ios, web
  deviceName  String?
  pushToken   String?
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@unique([userId, pushToken])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique
  deviceInfo    String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id          String   @id @default(cuid())
  phone       String
  codeHash    String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model Conversation {
  id          String   @id @default(cuid())
  type        ConversationType
  name        String? // group name
  avatarUrl   String?
  description String? @db.Text
  quote       String? @db.Text // group quote
  theme       String? @default("DEFAULT") // curated theme id
  accentColor String? @default("#0F4C4A")
  inviteLinkEnabled Boolean @default(true)
  joinApprovalRequired Boolean @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastMessageAt DateTime?
  lastMessagePreview String? @db.VarChar(200)

  members     Membership[]
  messages    Message[]
  plans       Plan[]
  triviaSessions TriviaSession[]
  inviteLinks InviteLink[]
  pinnedMessages PinnedMessage[]

  @@index([type])
  @@index([lastMessageAt])
}

model Membership {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  mutedUntil     DateTime?
  isArchived     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  lastReadSequence Int? // sequenceNumber
  lastReadMessageId String?
  unreadCount    Int      @default(0)
  isDeletedForUser Boolean @default(false) // delete for me conversation

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id              String   @id @default(cuid())
  clientMessageId String   // client-generated UUID for idempotency
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  type            MessageType @default(TEXT)
  body            String?  @db.Text
  sequenceNumber  Int // server authoritative per conversation
  replyToId       String?
  replyTo         Message? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("MessageReply")
  isEdited        Boolean  @default(false)
  editedAt        DateTime?
  isForwarded     Boolean  @default(false)
  forwardedFromId String?
  isDeletedForEveryone Boolean @default(false)
  deletedForEveryoneAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attachments     Attachment[]
  reactions       Reaction[]
  receipts        Receipt[]
  deletedFor      DeletedMessage[]
  pinnedIn        PinnedMessage[]

  @@unique([senderId, clientMessageId]) // idempotency
  @@index([conversationId, sequenceNumber])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model DeletedMessage {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  deletedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model Attachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type        String // image, voice, file
  url         String? // S3 key or presigned
  mimeType    String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  durationMs  Int?
  thumbnailUrl String?
  createdAt   DateTime @default(now())

  @@index([messageId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @db.VarChar(20)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Receipt {
  id             String   @id @default(cuid())
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  status         MessageStatus
  deviceId       String?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model PinnedMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById     String
  pinnedAt       DateTime @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model InviteLink {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  code           String   @unique
  createdById    String
  expiresAt      DateTime?
  maxUses        Int?
  useCount       Int      @default(0)
  isRevoked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([code])
}

// Planning Cards
model Plan {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organizerId    String
  organizer      User     @relation("PlanOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  title          String
  description    String?  @db.Text
  locationText   String?
  locationLink   String?
  budget         Decimal? @db.Decimal(12,2)
  currency       String?  @db.VarChar(3)
  minParticipants Int?
  isConfirmed    Boolean  @default(false)
  confirmedOptionId String?
  isCancelled    Boolean  @default(false)
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options        PlanOption[]
  rsvps          PlanRsvp[]
  votes          PlanVote[]

  @@index([conversationId])
  @@index([organizerId])
}

model PlanOption {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime?
  timeZone  String? // e.g. Asia/Kolkata
  createdAt DateTime @default(now())

  votes     PlanVote[]
  @@index([planId])
}

model PlanRsvp {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([planId, userId])
  @@index([userId])
}

model PlanVote {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  optionId  String
  option    PlanOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([planId, optionId, userId])
  @@unique([planId, userId]) // one vote per user per plan (changeable)
  @@index([userId])
}

// Trivia
model TriviaQuestion {
  id          String   @id @default(cuid())
  category    String
  question    String   @db.Text
  options     Json // ["A","B","C","D"]
  correctIndex Int
  difficulty  String @default("MEDIUM")
  createdAt   DateTime @default(now())

  @@index([category])
}

model TriviaSession {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedById    String
  state          TriviaState @default(LOBBY)
  currentQuestionIndex Int @default(0)
  questionIds    Json // ordered list of question ids
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants   TriviaParticipant[]
  answers        TriviaAnswer[]

  @@index([conversationId])
}

model TriviaParticipant {
  id        String   @id @default(cuid())
  sessionId String
  session   TriviaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  score     Int      @default(0)
  joinedAt  DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

model TriviaAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  session    TriviaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedIndex Int
  isCorrect  Boolean
  answeredAt DateTime @default(now())
  responseTimeMs Int?

  @@unique([sessionId, questionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// Calls
model Call {
  id             String   @id @default(cuid())
  conversationId String? // for 1-1, direct conversation id
  callerId       String
  calleeId       String
  type           CallType @default(AUDIO)
  status         CallStatus @default(RINGING)
  startedAt      DateTime @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  createdAt      DateTime @default(now())

  @@index([callerId])
  @@index([calleeId])
}

// Push
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Safety
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetGroupId String?
  targetMessageId String?
  reason      String
  details     String? @db.Text
  status      String @default("PENDING")
  reviewedBy  String?
  createdAt   DateTime @default(now())

  @@index([reporterId])
  @@index([status])
}
