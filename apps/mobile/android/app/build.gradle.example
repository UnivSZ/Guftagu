// Example android/app/build.gradle - ensure applicationId matches spec
// Do NOT commit keystore passwords. Use key.properties

android {
    namespace "com.ruhikreguftagu.saad"
    compileSdk 34

    defaultConfig {
        applicationId "com.ruhikreguftagu.saad"
        minSdk 23
        targetSdk 34
        versionCode 1
        versionName "0.1.0"
        multiDexEnabled true
    }

    signingConfigs {
        release {
            // load from key.properties
            // storeFile file(keystoreProperties['storeFile'])
            // storePassword keystoreProperties['storePassword']
            // keyAlias keystoreProperties['keyAlias']
            // keyPassword keystoreProperties['keyPassword']
        }
    }

    buildTypes {
        release {
            signingConfig signingConfigs.release
            minifyEnabled true
            shrinkResources true
        }
        debug {
            applicationIdSuffix ".debug"
        }
    }
}

flutter {
    source '../..'
}
